# Copy this file to .env. Never commit credentials.
# Image versions belong in compose.yaml, not in this local override file.
# Theme selection and the public Formspree endpoint belong in the site's config.yaml.
# On POSIX hosts, obtain your IDs with: id -u; id -g
LOCAL_UID=1000
LOCAL_GID=1000

HUGO_PORT=1313
HUGO_BUILDDRAFTS=false
HUGO_BUILDFUTURE=false

# Optional: enables Pexels backgrounds. Hugo emits this key into browser-visible HTML.
PEXELS_API_KEY=
